{
  "name": "engineering-interview-practice",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run generate-questions && next dev",
    "build": "npm run generate-questions && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run generate-questions && tsx --test tests/*.test.ts",
    "generate-questions": "tsx scripts/generate-questions.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@next/eslint-plugin-next": {
      "braces": "npm:@dieub/braces-depth-guard@3.0.3-pn.0"
    }
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "unrs-resolver@1.11.1": true,
    "fsevents@2.3.3": true
  }
}
